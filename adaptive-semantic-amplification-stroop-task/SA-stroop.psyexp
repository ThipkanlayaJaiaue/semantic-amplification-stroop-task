        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="sequenceGenerationPract2" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="code_2" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="&quot;&quot;&quot;&amp;#10;This script generates sequences of nogo stimuli&amp;#10;&quot;&quot;&quot;&amp;#10;&amp;#10;import numpy as np&amp;#10;import pandas as pd&amp;#10;import random&amp;#10;from collections import Counter&amp;#10;&amp;#10;trialAll_num = 40  # number of trials&amp;#10;trialCongruent_proportion = 1 / 2  # proportion of congruent trials&amp;#10;trialCongruent_num_expected = trialAll_num * trialCongruent_proportion  # num of congruent trials&amp;#10;&amp;#10;# create trial column&amp;#10;trial = 1+np.arange(0,trialAll_num)&amp;#10;&amp;#10;# %% create congruence column (list of &quot;congruent&quot; and &quot;incongruent&quot;)&amp;#10;# in the correct proportion and no more than 2 of the same condition (congruent, incongruent) consecutively&amp;#10;&amp;#10;# fill congruent column&amp;#10;congruent = np.ones(np.int64(trialAll_num))&amp;#10;toggleSwitch3 = 1&amp;#10;while toggleSwitch3==1:&amp;#10;    for trialIdx in np.arange(0,trialAll_num):&amp;#10;        if trial[trialIdx]&lt;=2:  # first two trials: random between 0 and 1&amp;#10;            congruent[trialIdx] = np.random.randint(0,2)&amp;#10;        else:&amp;#10;            if congruent[trialIdx-1]==congruent[trialIdx-2]:&amp;#10;                congruent[trialIdx]=np.abs(congruent[trialIdx-1]-1)  # either 1 = abs(0-1)   or  0 = abs(1-1)&amp;#10;            else:&amp;#10;                congruent[trialIdx] = np.random.randint(0,2)    &amp;#10;    # check that 50% congruent and 50% incongruent&amp;#10;    if sum(congruent)==(trialCongruent_num_expected):&amp;#10;        toggleSwitch3 = 0   &amp;#10;&amp;#10;# %% create word and color columns (combinations of words and colors)&amp;#10;&amp;#10;# pool of words and colors&amp;#10;pool = [&quot;yellow&quot;, &quot;green&quot;, &quot;red&quot;, &quot;blue&quot;]&amp;#10;&amp;#10;# initialize word and color columns&amp;#10;word = np.empty(trialAll_num,dtype=&quot;&lt;U6&quot;)&amp;#10;color = np.empty(trialAll_num,dtype=&quot;&lt;U6&quot;)&amp;#10;&amp;#10;toggleSwitch2 = 1&amp;#10;while toggleSwitch2==1:&amp;#10;    &amp;#10;    # fill word and color columns&amp;#10;    for trialIdx in np.arange(0,trialAll_num):&amp;#10;        # for first trial, no need to worry about the preceding trial (because it does not exist)&amp;#10;        if trialIdx==0:  &amp;#10;            if congruent[trialIdx]==1:&amp;#10;                word[trialIdx] = np.random.choice(pool,1)[0]&amp;#10;                color[trialIdx] = word[trialIdx]&amp;#10;            else:&amp;#10;                word[trialIdx] = np.random.choice(pool,1)[0]&amp;#10;                pool_red = np.delete(pool, pool.index(word[trialIdx]) )  # reduce color pool &amp;#10;                color[trialIdx] = np.random.choice(pool_red,1)[0]&amp;#10;            &amp;#10;        # from second trial onwards&amp;#10;        else:   &amp;#10;            if congruent[trialIdx]==1:   &amp;#10;                # reduce the pool so that not the same color is picked again&amp;#10;                pool_red = np.delete(pool, pool.index(word[trialIdx-1]) )  # reduce color pool &amp;#10;                word[trialIdx] = np.random.choice(pool_red,1)[0]&amp;#10;                color[trialIdx] = word[trialIdx]&amp;#10;            else:&amp;#10;                toggleSwitch = 1&amp;#10;                while toggleSwitch==1:&amp;#10;                    word[trialIdx] = np.random.choice(pool,1)[0]&amp;#10;                    pool_red = np.delete(pool, pool.index(word[trialIdx]) )  # reduce color pool &amp;#10;                    color[trialIdx] = np.random.choice(pool_red,1)[0]&amp;#10;                    if word[trialIdx]!=word[trialIdx-1]  and  color[trialIdx]!=color[trialIdx-1]:&amp;#10;                        toggleSwitch = 0&amp;#10;                        &amp;#10;    # check that each color is picked at least 20% of the times in the word and color columns                    &amp;#10;    wordProportion = np.empty(len(pool),dtype=float)     &amp;#10;    colorProportion = np.empty(len(pool),dtype=float)     &amp;#10;    for poolIdx in np.arange(0,len(pool)):&amp;#10;        wordProportion[poolIdx] = sum(word==pool[poolIdx])/trialAll_num&amp;#10;        colorProportion[poolIdx] = sum(color==pool[poolIdx])/trialAll_num&amp;#10;    if np.min(wordProportion)&gt;=0.20 and np.min(colorProportion)&gt;=0.20:&amp;#10;        toggleSwitch2 = 0&amp;#10;&amp;#10;# %% create nogo trials&amp;#10;# set blocks of nogo trials to contain specific range of number (varied numbers is randomly picked between a range to make it less predictable + faster for the code to run)&amp;#10;# add one color into each block (no same color repeat twice) and that color will be shown in the border&amp;#10;&amp;#10;# define nogo parameters&amp;#10;trialNogo_proportion = 1 / 4  # 25% nogo trials&amp;#10;trialNogo_congruent_proportion = 1 / 2 # 50% of nogo trials are congruent&amp;#10;trialNogo_num_expected = trialAll_num * trialNogo_proportion&amp;#10;trialNogo_congruent_num_expected = trialNogo_num_expected * trialNogo_congruent_proportion&amp;#10;trialNogo_incongruent_num_expected = trialNogo_num_expected - trialNogo_congruent_num_expected&amp;#10;&amp;#10;# define number of repeated colour in nogo block &amp;#10;nogoBlock_smallest_size = 3 # minimum repetetion in a block&amp;#10;nogoBlock_largest_size = 8 # maximum repetition in a block&amp;#10;nogoBlock_total_num = 10 # number of block&amp;#10;&amp;#10;# create a list to store nogo block size&amp;#10;nogoBlock_sizes_list = []&amp;#10;nogo_remaining_trials = trialAll_num&amp;#10;&amp;#10;toggleSwitch1 = 1&amp;#10;while toggleSwitch1 == 1:&amp;#10;&amp;#10;    toggleSwitch4 = 1&amp;#10;    while toggleSwitch4 == 1: # generate a list to contain blocks of numbers for nogo trials&amp;#10;        while len(nogoBlock_sizes_list) &lt; nogoBlock_total_num:&amp;#10;            # if it's the last block, take all remaining trials but not exceeding the largest size&amp;#10;            if len(nogoBlock_sizes_list) == nogoBlock_total_num - 1:&amp;#10;                nogoBlock_sizes_list.append(min(nogo_remaining_trials, nogoBlock_largest_size))&amp;#10;                nogo_remaining_trials = 0&amp;#10;&amp;#10;            else:&amp;#10;                # if it's not the last block, calculate the limit block size from the number of remaining blocks (to make sure we have enough trials for all blocks)&amp;#10;                # calculate the limit block size for the current nogo block to ensure that the the rest can still meet the criteria&amp;#10;                remaining_blocks = nogoBlock_total_num - len(nogoBlock_sizes_list) - 1&amp;#10;                limit_block_size = min(nogo_remaining_trials - remaining_blocks * nogoBlock_smallest_size, nogoBlock_largest_size)&amp;#10;&amp;#10;                nogoBlock_size = random.randint(nogoBlock_smallest_size, limit_block_size)  # choose a random block size within the specified range&amp;#10;                nogoBlock_sizes_list.append(nogoBlock_size)  # append the block size to the list&amp;#10;                nogo_remaining_trials -= nogoBlock_size&amp;#10;&amp;#10;        # check if the sum of nogo block sizes in the list equal to the total number of trials&amp;#10;        if sum(nogoBlock_sizes_list) == trialAll_num:&amp;#10;            toggleSwitch4 = 0&amp;#10;        else:&amp;#10;            # reset if the condition is not met&amp;#10;            nogoBlock_sizes_list.clear()&amp;#10;            nogo_remaining_trials = trialAll_num&amp;#10;&amp;#10;    # create a list to store nogo color&amp;#10;    nogo_color = []&amp;#10;    last_color = None&amp;#10;&amp;#10;    # create a for loop to add nogo colour in each block&amp;#10;    for nogoBlock_size in nogoBlock_sizes_list:&amp;#10;        # create variable for available colors that are not the same as the last added color&amp;#10;        available_colors = [nogoColor_pick for nogoColor_pick in pool if nogoColor_pick != last_color]&amp;#10;        new_color = random.choice(available_colors)&amp;#10;        nogo_color.extend([new_color] * nogoBlock_size)&amp;#10;        last_color = new_color&amp;#10;    &amp;#10;    # convert nogo_color to array for further condition check&amp;#10;    nogo_color_array = np.array(nogo_color)&amp;#10;    # create nogo-related arrays to mark nogo trials (1 or 0)&amp;#10;    nogo = np.where(word == nogo_color, 1, 0)&amp;#10;    nogo_congruent = np.where(((nogo == 1) &amp; (congruent == 1)), 1, 0)&amp;#10;    nogo_incongruent = np.where(((nogo == 1) &amp; (congruent == 0)), 1, 0)&amp;#10;   &amp;#10;    # use logical indexing to get 'nogo_congruent_colors' and 'nogo_congruent_colors' for further condition check&amp;#10;    nogo_congruent_colors = nogo_color_array[(nogo_congruent == 1)]&amp;#10;    nogo_incongruent_colors = nogo_color_array[(nogo_incongruent == 1)]&amp;#10;&amp;#10;    # create variables to count numbers of nogo trials, and number of nogo congruent trials&amp;#10;    trialNogo_count = np.sum(nogo == 1)&amp;#10;    trialNogo_congruent_count = np.sum(nogo_congruent == 1)&amp;#10;&amp;#10;    # create proportion variables for further condition check&amp;#10;    wordNogo_congruent_proportion = np.empty(len(pool), dtype=float)&amp;#10;    wordNogo_incongruent_proportion = np.empty(len(pool), dtype=float)&amp;#10;    for poolIdx2 in np.arange(len(pool)):&amp;#10;        wordNogo_congruent_proportion[poolIdx2] = np.sum((congruent == 0) &amp; (word == pool[poolIdx2]) &amp; (nogo == 1)) / trialNogo_incongruent_num_expected&amp;#10;        wordNogo_incongruent_proportion[poolIdx2] = np.sum((congruent == 1) &amp; (word == pool[poolIdx2]) &amp; (nogo == 1)) / trialNogo_incongruent_num_expected&amp;#10;&amp;#10;    # check if all conditions are satisfied&amp;#10;    if (all(color in nogo_color for color in pool) and  # all colours in pool are included in nogo_color array&amp;#10;        all(color in nogo_congruent_colors for color in pool) and # all colours in pool are included in nogo congruent array&amp;#10;        all(color in nogo_incongruent_colors for color in pool) and # all colours in pool are included in nogo incongruent array&amp;#10;        trialNogo_count == trialNogo_num_expected and  # total nogo trials as expected&amp;#10;        trialNogo_congruent_count == trialNogo_congruent_num_expected and  # congruent nogo trials as expected&amp;#10;        min(Counter(nogo_color).values()) &gt;= 0.20 * trialAll_num and  # minimum 20% of each colour in nogo_color (the border)&amp;#10;        np.min(wordNogo_congruent_proportion) &gt;= 0.125 and # minimun 12.5% of each colour is used as 'word' in nogo incongreunt&amp;#10;        np.min(wordNogo_incongruent_proportion) &gt;= 0.125): # minimun 12.5% of each colour is used as 'word' in nogo incongreunt&amp;#10;        toggleSwitch1 = 0&amp;#10;&amp;#10;# create expectedResponse&amp;#10;expectedResponse = np.array(['key2press' for _ in np.arange(trialAll_num)])&amp;#10;expectedResponse[color == &quot;yellow&quot;] = &quot;space&quot;&amp;#10;expectedResponse[color == &quot;green&quot;] = &quot;space&quot;&amp;#10;expectedResponse[color == &quot;blue&quot;] = &quot;space&quot;&amp;#10;expectedResponse[color == &quot;red&quot;] = &quot;space&quot;&amp;#10;expectedResponse[nogo == 1] = &quot;None&quot;&amp;#10;&amp;#10;# create dataset&amp;#10;practice_nogo = pd.DataFrame({'trial': trial,&amp;#10;                                'word': word,&amp;#10;                                'color': color,&amp;#10;                                'congruent': congruent,&amp;#10;                                'nogo_color': nogo_color,&amp;#10;                                'nogo': nogo,&amp;#10;                                'expectedResponse': expectedResponse,&amp;#10;                                'observedResponse': np.nan,&amp;#10;                                'Accuracy': np.nan,&amp;#10;                                'Accuracy_nogo': np.nan,&amp;#10;                                'AccuracyNogo': np.nan,&amp;#10;                                'RT_allTrials': np.nan,&amp;#10;                                'RT_correctTrials': np.nan,&amp;#10;                                'trialDuration': np.nan})&amp;#10;practice_nogo" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_2" valType="code" updates="None" name="name"/>
      </CodeComponent>
