        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# number of trials&amp;#10;Practice_allTrials_num = len(practice_stroop.Accuracy) &amp;#10;&amp;#10;# number of trials with correct answer, among the trialRange specified below to discard the first 2 trials&amp;#10;Practice_correctTrials_num = np.sum(practice_stroop.Accuracy)&amp;#10;&amp;#10;# percentage of trials with correct answer&amp;#10;Practice_correctTrials_pct= 100*Practice_correctTrials_num/ Practice_allTrials_num&amp;#10;&amp;#10;# Mdn RT for all responses&amp;#10;Practice_allTrials_MdnRT = np.median(practice_stroop.RT_allTrials)&amp;#10;&amp;#10;# Mdn RT for only correct responses&amp;#10;if Practice_correctTrials_num&gt; 0:&amp;#10;    Practice_correctTrials_MdnRT = np.nanmedian(practice_stroop.RT_correctTrials)&amp;#10;&amp;#10;# message for feedback&amp;#10;if Practice_correctTrials_num&gt; 0:&amp;#10;    msg = &quot;%i of %i correct responses \n%.2f%% correct \nMdn RT = %.2f s &quot; %(Practice_correctTrials_num, Practice_allTrials_num, Practice_correctTrials_pct, Practice_correctTrials_MdnRT )&amp;#10;else:&amp;#10;    msg = &quot;%i of %i correct responses \n%.2f%% correct&quot; %(Practice_correctTrials_num, Practice_allTrials_num, Practice_correctTrials_pct)&amp;#10;    &amp;#10;    &amp;#10;# color of feedback&amp;#10;if Practice_correctTrials_pct&gt;=70:&amp;#10;    fb_col = 'green'     # if accuracy is at least the value above&amp;#10;else:&amp;#10;    fb_col = 'red'" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if ((Practice_correctTrials_pct &gt;= 70)) {&amp;#10;    practiceStroopRepetition.finished = true;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="if Practice_correctTrials_pct &gt;= 70:&amp;#10;    practiceStroopRepetition.finished = True" valType="extendedCode" updates="constant" name="End Routine"/>
