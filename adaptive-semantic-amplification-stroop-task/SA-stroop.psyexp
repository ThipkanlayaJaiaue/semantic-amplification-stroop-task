        <Param val="import serial&amp;#10;&amp;#10;# connect to serial COM port&amp;#10;# True = yes for the experiment flow and the serial port communication&amp;#10;# False = no for the experiment flow only&amp;#10;# The COM port needs to be updated based on the specific device connection&amp;#10;doYouWantCOM = False&amp;#10;if doYouWantCOM:&amp;#10;    port = serial.Serial(port='COM7', baudrate=2000000)&amp;#10;    port.timeout = 1               # timeout 1 second (give 1 second to the board to initialize port)&amp;#10;&amp;#10;&amp;#10;marker_stimulusOnset_goCongruent     = 1&amp;#10;marker_stimulusOnset_goIncongruent   = 2&amp;#10;marker_stimulusOnset_nogoCongruent   = 4&amp;#10;marker_stimulusOnset_nogoIncongruent = 8&amp;#10;marker_response_goCorrect          = 16&amp;#10;marker_response_goIncorrect        = 32&amp;#10;marker_response_nogoIncorrect      = 64 # false positive" valType="extendedCode" updates="constant" name="Begin Experiment"/>
