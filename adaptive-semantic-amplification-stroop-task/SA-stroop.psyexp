        <Param val="if (((Practice_correctTrials_pct &gt;= 70) &amp;&amp; (Practice_correctNogoTrials_pct &gt;= 70))) {&amp;#10;    practiceNogoRepetition.finished = true;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="if Practice_correctTrials_pct &gt;= 70 and Practice_correctNogoTrials_pct &gt;= 70:&amp;#10;    practiceNogoRepetition.finished = True" valType="extendedCode" updates="constant" name="End Routine"/>
