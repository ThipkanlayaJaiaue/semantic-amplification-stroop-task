        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="psychoJS.experiment.addData(&quot;myStroopPract.trial&quot;, practice_stroop.trial[practiceStroopBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myStroopPract.word&quot;, practice_stroop.word[practiceStroopBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myStroopPract.color&quot;, practice_stroop.color[practiceStroopBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myStroopPract.congruent&quot;, practice_stroop.congruent[practiceStroopBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myStroopPract.expectedResponse&quot;, practice_stroop.expectedResponse[practiceStroopBlock.thisN]);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# add data about the sequence&amp;#10;thisExp.addData('myStroopPract.trial', practice_stroop.trial[practiceStroopBlock.thisN])&amp;#10;thisExp.addData('myStroopPract.word', practice_stroop.word[practiceStroopBlock.thisN])&amp;#10;thisExp.addData('myStroopPract.color', practice_stroop.color[practiceStroopBlock.thisN])&amp;#10;thisExp.addData('myStroopPract.congruent', practice_stroop.congruent[practiceStroopBlock.thisN])&amp;#10;thisExp.addData('myStroopPract.expectedResponse', practice_stroop.expectedResponse[practiceStroopBlock.thisN])" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if (stroopResp_3.keys) {&amp;#10;    practice_stroop.observedResponse[practiceStroopBlock.thisN] = stroopResp_3.keys;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myStroopPract.observedResponse&quot;, practice_stroop.observedResponse[practiceStroopBlock.thisN]);&amp;#10;practice_stroop.Accuracy[practiceStroopBlock.thisN] = Number.parseInt((practice_stroop.observedResponse[practiceStroopBlock.thisN] === practice_stroop.expectedResponse[practiceStroopBlock.thisN]));&amp;#10;psychoJS.experiment.addData(&quot;myStroopPract.Accuracy&quot;, practice_stroop.Accuracy[practiceStroopBlock.thisN]);&amp;#10;practice_stroop.RT_allTrials[practiceStroopBlock.thisN] = stroopResp_3.rt;&amp;#10;psychoJS.experiment.addData(&quot;myStroopPract.RT_allTrials&quot;, practice_stroop.RT_allTrials[practiceStroopBlock.thisN]);&amp;#10;if ((practice_stroop.Accuracy[practiceStroopBlock.thisN] === 1)) {&amp;#10;    practice_stroop.RT_correctTrials[practiceStroopBlock.thisN] = stroopResp_3.rt;&amp;#10;    psychoJS.experiment.addData(&quot;myStroopPract.RT_correctTrials&quot;, practice_stroop.RT_correctTrials[practiceStroopBlock.thisN]);&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# observed response&amp;#10;if stroopResp_3.keys:&amp;#10;    practice_stroop.observedResponse[practiceStroopBlock.thisN] = stroopResp_3.keys&amp;#10;thisExp.addData('myStroopPract.observedResponse',   practice_stroop.observedResponse[practiceStroopBlock.thisN])&amp;#10;&amp;#10;# Accuracy&amp;#10;practice_stroop.Accuracy[practiceStroopBlock.thisN]             = int(practice_stroop.observedResponse[practiceStroopBlock.thisN] == practice_stroop.expectedResponse[practiceStroopBlock.thisN]) &amp;#10;thisExp.addData('myStroopPract.Accuracy',         practice_stroop.Accuracy[practiceStroopBlock.thisN])&amp;#10;    &amp;#10;# RT all trials&amp;#10;practice_stroop.RT_allTrials[practiceStroopBlock.thisN]         = stroopResp_3.rt&amp;#10;thisExp.addData('myStroopPract.RT_allTrials',     practice_stroop.RT_allTrials[practiceStroopBlock.thisN])&amp;#10;    &amp;#10;# RT correct trials&amp;#10;if practice_stroop.Accuracy[practiceStroopBlock.thisN] == 1:&amp;#10;    practice_stroop.RT_correctTrials[practiceStroopBlock.thisN] = stroopResp_3.rt&amp;#10;    thisExp.addData('myStroopPract.RT_correctTrials',     practice_stroop.RT_correctTrials[practiceStroopBlock.thisN])&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
