      <CodeComponent name="expTone" plugin="None">
        <Param val="# sound parameters&amp;#10;errorBeep = sound.Sound(600, secs = 0.050, stereo=True, hamming=False, volume = 1)" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="errorBeep = new sound.Sound(600, {&quot;secs&quot;: 0.05, &quot;stereo&quot;: true, &quot;hamming&quot;: false, &quot;volume&quot;: 1});&amp;#10;" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="toggleBeep = false;&amp;#10;tonePlayed = false;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# for each trial reset error beep parameters&amp;#10;toggleBeep = False&amp;#10;tonePlayed = False" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="# determine if to play the error beep (within trial duration)&amp;#10;if len(stroopResp_2.keys)&gt;0 and stroopResp_2.corr!=1:&amp;#10;    toggleBeep = True # incorrect response key within the trial duration&amp;#10;    &amp;#10;# play the error beep&amp;#10;if toggleBeep==True and tonePlayed==False and errorBeep.status!=STARTED:&amp;#10;    errorBeep.play()&amp;#10;    tonePlayed = True" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (((stroopResp_2.keys.length &gt; 0) &amp;&amp; (stroopResp_2.corr !== 1))) {&amp;#10;    toggleBeep = true;&amp;#10;}&amp;#10;if ((((toggleBeep === true) &amp;&amp; (tonePlayed === false)) &amp;&amp; (errorBeep.status !== PsychoJS.Status.STARTED))) {&amp;#10;    errorBeep.play();&amp;#10;    tonePlayed = true;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if (((stroopResp_2.keys === null) &amp;&amp; (stroopResp_2.corr !== 1))) {&amp;#10;    toggleBeep = true;&amp;#10;}&amp;#10;if ((((toggleBeep === true) &amp;&amp; (tonePlayed === false)) &amp;&amp; (errorBeep.status !== PsychoJS.Status.STARTED))) {&amp;#10;    errorBeep.play();&amp;#10;    tonePlayed = true;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# determine if to play the error beep (at end of trial duration)&amp;#10;if stroopResp_2.keys==None and stroopResp_2.corr!=1:&amp;#10;    toggleBeep = True # no response (where one, correct, was expected) by the end of the trial duration&amp;#10;&amp;#10;# play the error beep&amp;#10;if toggleBeep==True and tonePlayed==False and errorBeep.status!=STARTED:&amp;#10;    errorBeep.play()&amp;#10;    tonePlayed = True" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="expTone" valType="code" updates="None" name="name"/>
      </CodeComponent>
