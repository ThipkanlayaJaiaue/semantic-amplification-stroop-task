        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if (stroopResp_3.corr) {&amp;#10;    fb_text = &quot;Correct!&quot;;&amp;#10;    fb_col = &quot;green&quot;;&amp;#10;    sound_volume = 0;&amp;#10;} else {&amp;#10;    fb_text = &quot;Incorrect&quot;;&amp;#10;    fb_col = &quot;red&quot;;&amp;#10;    sound_volume = 1;&amp;#10;}&amp;#10;fb_duration = 0.5;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# text, color, and sound of feedback&amp;#10;if stroopResp_3.corr:&amp;#10;    fb_text = 'Correct!'&amp;#10;    fb_col = 'green'&amp;#10;    sound_volume = 0&amp;#10;else:&amp;#10;    fb_text = 'Incorrect'&amp;#10;    fb_col = 'red'&amp;#10;    sound_volume = 1&amp;#10;&amp;#10;# duration of feedback&amp;#10;fb_duration = 0.5" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
