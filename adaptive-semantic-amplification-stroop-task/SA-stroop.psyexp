      <CodeComponent name="expTrial_serialCOM_2" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="stimulusPulse_sent = false;&amp;#10;responsePulse_sent = false;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# initialize variables controlling whether the stimulus and response triggers have been sent for this trial&amp;#10;stimulusPulse_sent = False&amp;#10;responsePulse_sent = False" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="# communicate with the serial port&amp;#10;if doYouWantCOM:&amp;#10;    &amp;#10;    # send stimulus pulse and record at what time it is sent&amp;#10;    if stroopStim_2.status == STARTED and not stimulusPulse_sent:&amp;#10;        # decide which marker to send&amp;#10;        if sequenceDataset.congruent[experimentalBlock.thisN]:&amp;#10;            if sequenceDataset.nogo[experimentalBlock.thisN]:&amp;#10;                stimmarker2send = marker_stimulusOnset_nogoCongruent&amp;#10;            else:&amp;#10;                stimmarker2send = marker_stimulusOnset_goCongruent&amp;#10;        else:&amp;#10;            if sequenceDataset.nogo[experimentalBlock.thisN]:&amp;#10;                stimmarker2send = marker_stimulusOnset_nogoIncongruent&amp;#10;            else:&amp;#10;                stimmarker2send = marker_stimulusOnset_goIncongruent&amp;#10;        # send marker&amp;#10;        win.callOnFlip(port.write, [stimmarker2send])&amp;#10;        stimulusPulse_startTime = core.monotonicClock.getTime()&amp;#10;        stimulusPulse_sent = True&amp;#10;        stimulusPulse_terminated = False&amp;#10;    # forcing termination of a stimulus pulse if it lasts at least 20 ms&amp;#10;    if stimulusPulse_sent and not stimulusPulse_terminated:  &amp;#10;        if core.monotonicClock.getTime() - stimulusPulse_startTime &gt;= 0.020:&amp;#10;            win.callOnFlip(port.write, [0])&amp;#10;            stimulusPulse_terminated = True&amp;#10;    &amp;#10;    &amp;#10;    # send a response pulse and record at what time it is sent&amp;#10;    if len(stroopResp_2.keys)&gt;0 and not responsePulse_sent:&amp;#10;        # decide which marker to send&amp;#10;        if sequenceDataset.nogo[experimentalBlock.thisN]:&amp;#10;            respmarker2send = marker_response_nogoIncorrect&amp;#10;        else:&amp;#10;            if stroopResp_2.corr:&amp;#10;                respmarker2send = marker_response_goCorrect&amp;#10;            else:&amp;#10;                respmarker2send = marker_response_goIncorrect&amp;#10;        # send marker&amp;#10;        win.callOnFlip(port.write, [respmarker2send])&amp;#10;        responsePulse_startTime = core.monotonicClock.getTime()&amp;#10;        responsePulse_sent = True&amp;#10;        responsePulse_terminated = False&amp;#10;    # forcing termination of a response pulse if it lasts at least 20 ms&amp;#10;    if responsePulse_sent and not responsePulse_terminated:  &amp;#10;        if core.monotonicClock.getTime() - responsePulse_startTime &gt;= 0.020:&amp;#10;            win.callOnFlip(port.write, [0])&amp;#10;            responsePulse_terminated = True&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (doYouWantCOM) {&amp;#10;    if (((stroopStim_2.status === PsychoJS.Status.STARTED) &amp;&amp; (! stimulusPulse_sent))) {&amp;#10;        if (sequenceDataset.congruent[experimentalBlock.thisN]) {&amp;#10;            if (sequenceDataset.nogo[experimentalBlock.thisN]) {&amp;#10;                stimmarker2send = marker_stimulusOnset_nogoCongruent;&amp;#10;            } else {&amp;#10;                stimmarker2send = marker_stimulusOnset_goCongruent;&amp;#10;            }&amp;#10;        } else {&amp;#10;            if (sequenceDataset.nogo[experimentalBlock.thisN]) {&amp;#10;                stimmarker2send = marker_stimulusOnset_nogoIncongruent;&amp;#10;            } else {&amp;#10;                stimmarker2send = marker_stimulusOnset_goIncongruent;&amp;#10;            }&amp;#10;        }&amp;#10;        psychoJS.window.callOnFlip(port.write, [stimmarker2send]);&amp;#10;        stimulusPulse_startTime = core.monotonicClock.getTime();&amp;#10;        stimulusPulse_sent = true;&amp;#10;        stimulusPulse_terminated = false;&amp;#10;    }&amp;#10;    if ((stimulusPulse_sent &amp;&amp; (! stimulusPulse_terminated))) {&amp;#10;        if (((core.monotonicClock.getTime() - stimulusPulse_startTime) &gt;= 0.02)) {&amp;#10;            psychoJS.window.callOnFlip(port.write, [0]);&amp;#10;            stimulusPulse_terminated = true;&amp;#10;        }&amp;#10;    }&amp;#10;    if (((stroopResp_2.keys.length &gt; 0) &amp;&amp; (! responsePulse_sent))) {&amp;#10;        if (sequenceDataset.nogo[experimentalBlock.thisN]) {&amp;#10;            respmarker2send = marker_response_nogoIncorrect;&amp;#10;        } else {&amp;#10;            if (stroopResp_2.corr) {&amp;#10;                respmarker2send = marker_response_goCorrect;&amp;#10;            } else {&amp;#10;                respmarker2send = marker_response_goIncorrect;&amp;#10;            }&amp;#10;        }&amp;#10;        psychoJS.window.callOnFlip(port.write, [respmarker2send]);&amp;#10;        responsePulse_startTime = core.monotonicClock.getTime();&amp;#10;        responsePulse_sent = true;&amp;#10;        responsePulse_terminated = false;&amp;#10;    }&amp;#10;    if ((responsePulse_sent &amp;&amp; (! responsePulse_terminated))) {&amp;#10;        if (((core.monotonicClock.getTime() - responsePulse_startTime) &gt;= 0.02)) {&amp;#10;            psychoJS.window.callOnFlip(port.write, [0]);&amp;#10;            responsePulse_terminated = true;&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="if (stimulusPulse_sent) {&amp;#10;    psychoJS.experiment.addData(&quot;myExp.stimulusPulse_startTime&quot;, stimulusPulse_startTime);&amp;#10;    psychoJS.experiment.addData(&quot;myExp.stimulusPulse_marker&quot;, stimmarker2send);&amp;#10;}&amp;#10;if (responsePulse_sent) {&amp;#10;    psychoJS.experiment.addData(&quot;myExp.responsePulse_startTime&quot;, responsePulse_startTime);&amp;#10;    psychoJS.experiment.addData(&quot;myExp.responsePulse_marker&quot;, respmarker2send);&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# add timing of triggers&amp;#10;if stimulusPulse_sent:&amp;#10;    thisExp.addData('myExp.stimulusPulse_startTime', stimulusPulse_startTime)&amp;#10;    thisExp.addData('myExp.stimulusPulse_marker', stimmarker2send)&amp;#10;if responsePulse_sent:&amp;#10;    thisExp.addData('myExp.responsePulse_startTime', responsePulse_startTime)&amp;#10;    thisExp.addData('myExp.responsePulse_marker', respmarker2send)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="expTrial_serialCOM_2" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="expAfterKeyPress" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
