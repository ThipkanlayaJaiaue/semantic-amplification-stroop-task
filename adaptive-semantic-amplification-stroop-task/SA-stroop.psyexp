        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if (key_resp_4.corr) {&amp;#10;    fb_text = &quot;Correct!&quot;;&amp;#10;    fb_col = &quot;green&quot;;&amp;#10;    sound_volume = 0;&amp;#10;} else {&amp;#10;    if (((practice_nogo.observedResponse[practiceNogoBlock.thisN] === &quot;None&quot;) &amp;&amp; (practice_nogo.nogo[practiceNogoBlock.thisN] === 0))) {&amp;#10;        fb_text = &quot;Fail to respond&quot;;&amp;#10;        fb_col = &quot;red&quot;;&amp;#10;        sound_volume = 1;&amp;#10;    } else {&amp;#10;        fb_text = &quot;Fail to stop&quot;;&amp;#10;        fb_col = &quot;red&quot;;&amp;#10;        sound_volume = 1;&amp;#10;    }&amp;#10;}&amp;#10;fb_duration = 0.5;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
