        <Param val="# force stimuli to disappear after keypress&amp;#10;if stroopResp_2.keys:&amp;#10;    stroopStim_2.color = [0, 0, 0]&amp;#10;    #polygon.opacity = 0" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (stroopResp_2.keys) {&amp;#10;    stroopStim_2.color = [0, 0, 0];&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
