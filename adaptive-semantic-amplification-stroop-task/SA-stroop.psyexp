      <CodeComponent name="addData_2" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="psychoJS.experiment.addData(&quot;myExp.trial&quot;, sequenceDataset.trial[experimentalBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myExp.word&quot;, sequenceDataset.word[experimentalBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myExp.color&quot;, sequenceDataset.color[experimentalBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myExp.congruent&quot;, sequenceDataset.congruent[experimentalBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myExp.nogo_color&quot;, sequenceDataset.nogo_color[experimentalBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myExp.nogo&quot;, sequenceDataset.nogo[experimentalBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myExp.expectedResponse&quot;, sequenceDataset.expectedResponse[experimentalBlock.thisN]);&amp;#10;if ((sequenceDataset.trial[experimentalBlock.thisN] === 1)) {&amp;#10;    if ((sequenceDataset.nogo[experimentalBlock.thisN] === 0)) {&amp;#10;        sequenceDataset.trialDuration[experimentalBlock.thisN] = (0.5 + Practice_correctTrials_3qrtRT);&amp;#10;    } else {&amp;#10;        sequenceDataset.trialDuration[experimentalBlock.thisN] = ((0.5 + Practice_correctTrials_3qrtRT) + 1);&amp;#10;    }&amp;#10;} else {&amp;#10;    last_go_duration = 0;&amp;#10;    adaptation_sum = 0;&amp;#10;    found_last_go = false;&amp;#10;    for (var lastgoIdx, _pj_c = 0, _pj_a = util.range((experimentalBlock.thisN - 1), (- 1), (- 1)), _pj_b = _pj_a.length; (_pj_c &lt; _pj_b); _pj_c += 1) {&amp;#10;        lastgoIdx = _pj_a[_pj_c];&amp;#10;        if ((sequenceDataset.nogo[lastgoIdx] === 0)) {&amp;#10;            last_go_duration = sequenceDataset.trialDuration[lastgoIdx];&amp;#10;            found_last_go = true;&amp;#10;            adaptation_sum += sequenceDataset.step[lastgoIdx];&amp;#10;            break;&amp;#10;        }&amp;#10;        adaptation_sum += sequenceDataset.step[lastgoIdx];&amp;#10;    }&amp;#10;    if ((sequenceDataset.nogo[experimentalBlock.thisN] === 1)) {&amp;#10;        if (found_last_go) {&amp;#10;            sequenceDataset.trialDuration[experimentalBlock.thisN] = ((last_go_duration + adaptation_sum) + 1);&amp;#10;        } else {&amp;#10;            sequenceDataset.trialDuration[experimentalBlock.thisN] = (sequenceDataset.trialDuration[(experimentalBlock.thisN - 1)] + sequenceDataset.step[(experimentalBlock.thisN - 1)]);&amp;#10;        }&amp;#10;    } else {&amp;#10;        if (found_last_go) {&amp;#10;            sequenceDataset.trialDuration[experimentalBlock.thisN] = (last_go_duration + adaptation_sum);&amp;#10;        } else {&amp;#10;            sequenceDataset.trialDuration[experimentalBlock.thisN] = ((sequenceDataset.trialDuration[(experimentalBlock.thisN - 1)] + sequenceDataset.step[(experimentalBlock.thisN - 1)]) - 1);&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# add data about the sequence&amp;#10;thisExp.addData('myExp.trial',            sequenceDataset.trial[experimentalBlock.thisN])&amp;#10;thisExp.addData('myExp.word',             sequenceDataset.word[experimentalBlock.thisN])&amp;#10;thisExp.addData('myExp.color',            sequenceDataset.color[experimentalBlock.thisN])&amp;#10;thisExp.addData('myExp.congruent',        sequenceDataset.congruent[experimentalBlock.thisN])&amp;#10;thisExp.addData('myExp.nogo_color',       sequenceDataset.nogo_color[experimentalBlock.thisN])&amp;#10;thisExp.addData('myExp.nogo',             sequenceDataset.nogo[experimentalBlock.thisN])&amp;#10;thisExp.addData('myExp.expectedResponse', sequenceDataset.expectedResponse[experimentalBlock.thisN])&amp;#10;&amp;#10;# adaptive duration&amp;#10;if sequenceDataset.trial[experimentalBlock.thisN] == 1: # first trial&amp;#10;    if sequenceDataset.nogo[experimentalBlock.thisN] == 0: # if it's go trial&amp;#10;        sequenceDataset.trialDuration[experimentalBlock.thisN] = 0.5 + Practice_correctTrials_3qrtRT # use the RT + 500ms&amp;#10;    else:  # if it's nogo trial&amp;#10;        sequenceDataset.trialDuration[experimentalBlock.thisN] = (0.5 + Practice_correctTrials_3qrtRT) + 1 # use the RT + 500ms + 1000ms&amp;#10;        &amp;#10;else: # not the first trial&amp;#10;    last_go_duration = 0&amp;#10;    adaptation_sum = 0&amp;#10;    found_last_go = False&amp;#10;    &amp;#10;    # set a loop backwards to find the last go trial&amp;#10;    for lastgoIdx in range(experimentalBlock.thisN - 1, -1, -1):&amp;#10;        if sequenceDataset.nogo[lastgoIdx] == 0:  # if there was a last go&amp;#10;            last_go_duration = sequenceDataset.trialDuration[lastgoIdx]&amp;#10;            found_last_go = True&amp;#10;            &amp;#10;            # add the adaptation from the last go trial's accuracy&amp;#10;            adaptation_sum += sequenceDataset.step[lastgoIdx]&amp;#10;            break&amp;#10;        &amp;#10;        # sum adaptations from last go onwards until the previous one&amp;#10;        adaptation_sum += sequenceDataset.step[lastgoIdx]&amp;#10;&amp;#10;    if sequenceDataset.nogo[experimentalBlock.thisN] == 1: # if current trial is nogo&amp;#10;        if found_last_go: # if a go trial was found, calculate duration based on last go duration + adaptation(s), then + 1&amp;#10;            sequenceDataset.trialDuration[experimentalBlock.thisN] = (last_go_duration + adaptation_sum) + 1&amp;#10;        else:&amp;#10;            # if the last go trial is not found (it has been nogo from the first trial until the current one), use the normal adaptation rule (previous trial duration + step based on its accuracy)&amp;#10;            sequenceDataset.trialDuration[experimentalBlock.thisN] = sequenceDataset.trialDuration[experimentalBlock.thisN-1] + sequenceDataset.step[experimentalBlock.thisN-1]&amp;#10;    else: # if current trial is go&amp;#10;        if found_last_go:&amp;#10;            sequenceDataset.trialDuration[experimentalBlock.thisN] = last_go_duration + adaptation_sum&amp;#10;        else: # previous trial was go, use the normal adaptation rule (previous trial duration + step based on its accuracy) 1 1          &amp;#10;            sequenceDataset.trialDuration[experimentalBlock.thisN] = (sequenceDataset.trialDuration[experimentalBlock.thisN-1] + sequenceDataset.step[experimentalBlock.thisN-1]) - 1&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# observed response&amp;#10;if stroopResp_2.keys:&amp;#10;    sequenceDataset.observedResponse[experimentalBlock.thisN] = stroopResp_2.keys&amp;#10;else:&amp;#10;    sequenceDataset.observedResponse[experimentalBlock.thisN] = 'None'&amp;#10;thisExp.addData('myExp.observedResponse', sequenceDataset.observedResponse[experimentalBlock.thisN])&amp;#10;&amp;#10;# trialDuration&amp;#10;thisExp.addData('myExp.trialDuration',      sequenceDataset.trialDuration[experimentalBlock.thisN])&amp;#10;&amp;#10;# Accuracy&amp;#10;if sequenceDataset.nogo[experimentalBlock.thisN] == 1:&amp;#10;    sequenceDataset.Accuracy[experimentalBlock.thisN]             = int(sequenceDataset.observedResponse[experimentalBlock.thisN] == &quot;None&quot;) &amp;#10;else:&amp;#10;    sequenceDataset.Accuracy[experimentalBlock.thisN]             = int(sequenceDataset.expectedResponse[experimentalBlock.thisN] == sequenceDataset.observedResponse[experimentalBlock.thisN]) &amp;#10;thisExp.addData('myExp.Accuracy',         sequenceDataset.Accuracy[experimentalBlock.thisN])&amp;#10;&amp;#10;# AccuracyNogo&amp;#10;if sequenceDataset.nogo[experimentalBlock.thisN] == 1:&amp;#10;    sequenceDataset.AccuracyNogo[experimentalBlock.thisN] = int(sequenceDataset.observedResponse[experimentalBlock.thisN] == &quot;None&quot;) &amp;#10;thisExp.addData('myExp.AccuracyNogo',         sequenceDataset.AccuracyNogo[experimentalBlock.thisN])&amp;#10;&amp;#10;# RT all trials&amp;#10;if stroopResp_2.keys:&amp;#10;    sequenceDataset.RT_allTrials[experimentalBlock.thisN]         = stroopResp_2.rt&amp;#10;    thisExp.addData('myExp.RT_allTrials',     sequenceDataset.RT_allTrials[experimentalBlock.thisN])&amp;#10;    &amp;#10;# RT correct trials&amp;#10;if stroopResp_2.keys and sequenceDataset.Accuracy[experimentalBlock.thisN] == 1 and sequenceDataset.nogo[experimentalBlock.thisN] != 1:&amp;#10;    sequenceDataset.RT_correctTrials[experimentalBlock.thisN] = stroopResp_2.rt&amp;#10;    thisExp.addData('myExp.RT_correctTrials',     sequenceDataset.RT_correctTrials[experimentalBlock.thisN])&amp;#10;&amp;#10;# adaptation&amp;#10;if sequenceDataset.congruent[experimentalBlock.thisN]== 0 and sequenceDataset.nogo[experimentalBlock.thisN]== 0:&amp;#10;   if sequenceDataset.Accuracy[experimentalBlock.thisN] == 1:&amp;#10;       sequenceDataset.step[experimentalBlock.thisN]    = -0.05    # if correct response, decrease duration&amp;#10;   else:&amp;#10;        sequenceDataset.step[experimentalBlock.thisN]    = +0.05    # otherwise (incorrect or no response), increase duration&amp;#10;else:&amp;#10;    sequenceDataset.step[experimentalBlock.thisN]    = 0.0&amp;#10;thisExp.addData('myExp.step',         sequenceDataset.step[experimentalBlock.thisN])&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="addData_2" valType="code" updates="None" name="name"/>
