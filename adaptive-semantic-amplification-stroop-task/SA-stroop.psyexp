      <CodeComponent name="code_3" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="psychoJS.experiment.addData(&quot;myNogoPract.trial&quot;, practice_nogo.trial[practiceNogoBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myNogoPract.word&quot;, practice_nogo.word[practiceNogoBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myNogoPract.color&quot;, practice_nogo.color[practiceNogoBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myNogoPract.congruent&quot;, practice_nogo.congruent[practiceNogoBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myNogoPract.nogo_color&quot;, practice_nogo.nogo_color[practiceNogoBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myNogoPract.nogo&quot;, practice_nogo.nogo[practiceNogoBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myNogoPract.expectedResponse&quot;, practice_nogo.expectedResponse[practiceNogoBlock.thisN]);&amp;#10;time_limit = 2;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# add data about the sequence&amp;#10;thisExp.addData('myNogoPract.trial', practice_nogo.trial[practiceNogoBlock.thisN])&amp;#10;thisExp.addData('myNogoPract.word', practice_nogo.word[practiceNogoBlock.thisN])&amp;#10;thisExp.addData('myNogoPract.color', practice_nogo.color[practiceNogoBlock.thisN])&amp;#10;thisExp.addData('myNogoPract.congruent', practice_nogo.congruent[practiceNogoBlock.thisN])&amp;#10;thisExp.addData('myNogoPract.nogo_color', practice_nogo.nogo_color[practiceNogoBlock.thisN])&amp;#10;thisExp.addData('myNogoPract.nogo',  practice_nogo.nogo[practiceNogoBlock.thisN])&amp;#10;thisExp.addData('myNogoPract.expectedResponse', practice_nogo.expectedResponse[practiceNogoBlock.thisN])&amp;#10;&amp;#10;# set response time limit&amp;#10;time_limit = 2&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="import * as np from 'numpy';&amp;#10;if (key_resp_4.keys) {&amp;#10;    practice_nogo.observedResponse[practiceNogoBlock.thisN] = key_resp_4.keys;&amp;#10;} else {&amp;#10;    practice_nogo.observedResponse[practiceNogoBlock.thisN] = &quot;None&quot;;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myNogoPract.observedResponse&quot;, practice_nogo.observedResponse[practiceNogoBlock.thisN]);&amp;#10;if ((practice_nogo.nogo[practiceNogoBlock.thisN] === 1)) {&amp;#10;    practice_nogo.Accuracy[practiceNogoBlock.thisN] = Number.parseInt((practice_nogo.observedResponse[practiceNogoBlock.thisN] === &quot;None&quot;));&amp;#10;} else {&amp;#10;    practice_nogo.Accuracy[practiceNogoBlock.thisN] = Number.parseInt((practice_nogo.expectedResponse[practiceNogoBlock.thisN] === practice_nogo.observedResponse[practiceNogoBlock.thisN]));&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myNogoPract.Accuracy&quot;, practice_nogo.Accuracy[practiceNogoBlock.thisN]);&amp;#10;if ((practice_nogo.nogo[practiceNogoBlock.thisN] === 1)) {&amp;#10;    practice_nogo.AccuracyNogo[practiceNogoBlock.thisN] = Number.parseInt((practice_nogo.observedResponse[practiceNogoBlock.thisN] === &quot;None&quot;));&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myNogoPract.AccuracyNogo&quot;, practice_nogo.AccuracyNogo[practiceNogoBlock.thisN]);&amp;#10;if ((key_resp_4.keys &amp;&amp; (practice_nogo.nogo[practiceNogoBlock.thisN] !== 1))) {&amp;#10;    practice_nogo.RT_allTrials[practiceNogoBlock.thisN] = key_resp_4.rt;&amp;#10;    psychoJS.experiment.addData(&quot;myNogoPract.RT_allTrials&quot;, practice_nogo.RT_allTrials[practiceNogoBlock.thisN]);&amp;#10;}&amp;#10;if (((key_resp_4.keys &amp;&amp; (practice_nogo.Accuracy[practiceNogoBlock.thisN] === 1)) &amp;&amp; (practice_nogo.nogo[practiceNogoBlock.thisN] !== 1))) {&amp;#10;    practice_nogo.RT_correctTrials[practiceNogoBlock.thisN] = key_resp_4.rt;&amp;#10;    psychoJS.experiment.addData(&quot;myNogoPract.RT_correctTrials&quot;, practice_nogo.RT_correctTrials[practiceNogoBlock.thisN]);&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="import numpy as np&amp;#10;&amp;#10;# observed response&amp;#10;if key_resp_4.keys:&amp;#10;    practice_nogo.observedResponse[practiceNogoBlock.thisN] = key_resp_4.keys&amp;#10;else:&amp;#10;    practice_nogo.observedResponse[practiceNogoBlock.thisN] = 'None'&amp;#10;thisExp.addData('myNogoPract.observedResponse', practice_nogo.observedResponse[practiceNogoBlock.thisN])&amp;#10;&amp;#10;# Accuracy&amp;#10;if practice_nogo.nogo[practiceNogoBlock.thisN] == 1:&amp;#10;    practice_nogo.Accuracy[practiceNogoBlock.thisN]             = int(practice_nogo.observedResponse[practiceNogoBlock.thisN] == &quot;None&quot;) &amp;#10;else:&amp;#10;    practice_nogo.Accuracy[practiceNogoBlock.thisN]             = int(practice_nogo.expectedResponse[practiceNogoBlock.thisN] == practice_nogo.observedResponse[practiceNogoBlock.thisN]) &amp;#10;thisExp.addData('myNogoPract.Accuracy',         practice_nogo.Accuracy[practiceNogoBlock.thisN])&amp;#10;&amp;#10;# AccuracyNogo&amp;#10;if practice_nogo.nogo[practiceNogoBlock.thisN] == 1:&amp;#10;    practice_nogo.AccuracyNogo[practiceNogoBlock.thisN] = int(practice_nogo.observedResponse[practiceNogoBlock.thisN] == &quot;None&quot;) &amp;#10;thisExp.addData('myNogoPract.AccuracyNogo',         practice_nogo.AccuracyNogo[practiceNogoBlock.thisN])&amp;#10;&amp;#10;# RT all trials&amp;#10;if key_resp_4.keys and practice_nogo.nogo[practiceNogoBlock.thisN] != 1:&amp;#10;    practice_nogo.RT_allTrials[practiceNogoBlock.thisN]         = key_resp_4.rt&amp;#10;    thisExp.addData('myNogoPract.RT_allTrials',     practice_nogo.RT_allTrials[practiceNogoBlock.thisN])&amp;#10;    &amp;#10;# RT correct trials&amp;#10;if key_resp_4.keys and practice_nogo.Accuracy[practiceNogoBlock.thisN] == 1 and practice_nogo.nogo[practiceNogoBlock.thisN] != 1:&amp;#10;    practice_nogo.RT_correctTrials[practiceNogoBlock.thisN] = key_resp_4.rt&amp;#10;    thisExp.addData('myNogoPract.RT_correctTrials',     practice_nogo.RT_correctTrials[practiceNogoBlock.thisN])&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
