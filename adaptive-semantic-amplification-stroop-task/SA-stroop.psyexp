      <CodeComponent name="addData" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="psychoJS.experiment.addData(&quot;myPract.trial&quot;, sequenceDataset.trial[practiceBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myPract.word&quot;, sequenceDataset.word[practiceBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myPract.color&quot;, sequenceDataset.color[practiceBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myPract.congruent&quot;, sequenceDataset.congruent[practiceBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myPract.nogo_color&quot;, sequenceDataset.nogo_color[practiceBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myPract.nogo&quot;, sequenceDataset.nogo[practiceBlock.thisN]);&amp;#10;psychoJS.experiment.addData(&quot;myPract.expectedResponse&quot;, sequenceDataset.expectedResponse[practiceBlock.thisN]);&amp;#10;if ((sequenceDataset.nogo[practiceBlock.thisN] === 1)) {&amp;#10;    time_limit = 2;&amp;#10;} else {&amp;#10;    time_limit = Number.parseFloat(&quot;inf&quot;);&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# add data about the sequence&amp;#10;thisExp.addData('myPract.trial', sequenceDataset.trial[practiceBlock.thisN])&amp;#10;thisExp.addData('myPract.word', sequenceDataset.word[practiceBlock.thisN])&amp;#10;thisExp.addData('myPract.color', sequenceDataset.color[practiceBlock.thisN])&amp;#10;thisExp.addData('myPract.congruent', sequenceDataset.congruent[practiceBlock.thisN])&amp;#10;thisExp.addData('myPract.nogo_color', sequenceDataset.nogo_color[practiceBlock.thisN])&amp;#10;thisExp.addData('myPract.nogo',  sequenceDataset.nogo[practiceBlock.thisN])&amp;#10;thisExp.addData('myPract.expectedResponse', sequenceDataset.expectedResponse[practiceBlock.thisN])&amp;#10;&amp;#10;# set response time limit&amp;#10;if sequenceDataset.nogo[practiceBlock.thisN] == 1:&amp;#10;    time_limit = 2  # 2 seconds for nogo trials&amp;#10;else:&amp;#10;    time_limit = float('inf')  # Unlimited for go trials" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="import * as np from 'numpy';&amp;#10;if (stroopResp.keys) {&amp;#10;    sequenceDataset.observedResponse[practiceBlock.thisN] = stroopResp.keys;&amp;#10;} else {&amp;#10;    sequenceDataset.observedResponse[practiceBlock.thisN] = &quot;None&quot;;&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myPract.observedResponse&quot;, sequenceDataset.observedResponse[practiceBlock.thisN]);&amp;#10;if ((sequenceDataset.nogo[practiceBlock.thisN] === 1)) {&amp;#10;    sequenceDataset.Accuracy[practiceBlock.thisN] = Number.parseInt((sequenceDataset.observedResponse[practiceBlock.thisN] === &quot;None&quot;));&amp;#10;} else {&amp;#10;    sequenceDataset.Accuracy[practiceBlock.thisN] = Number.parseInt((sequenceDataset.expectedResponse[practiceBlock.thisN] === sequenceDataset.observedResponse[practiceBlock.thisN]));&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myPract.Accuracy&quot;, sequenceDataset.Accuracy[practiceBlock.thisN]);&amp;#10;if ((sequenceDataset.nogo[practiceBlock.thisN] === 1)) {&amp;#10;    sequenceDataset.AccuracyNogo[practiceBlock.thisN] = Number.parseInt((sequenceDataset.observedResponse[practiceBlock.thisN] === &quot;None&quot;));&amp;#10;}&amp;#10;psychoJS.experiment.addData(&quot;myPract.AccuracyNogo&quot;, sequenceDataset.AccuracyNogo[practiceBlock.thisN]);&amp;#10;if ((sequenceDataset.nogo[practiceBlock.thisN] !== 1)) {&amp;#10;    sequenceDataset.RT_allTrials[practiceBlock.thisN] = stroopResp.rt;&amp;#10;    psychoJS.experiment.addData(&quot;myPract.RT_allTrials&quot;, sequenceDataset.RT_allTrials[practiceBlock.thisN]);&amp;#10;}&amp;#10;if (((sequenceDataset.Accuracy[practiceBlock.thisN] === 1) &amp;&amp; (sequenceDataset.nogo[practiceBlock.thisN] !== 1))) {&amp;#10;    sequenceDataset.RT_correctTrials[practiceBlock.thisN] = stroopResp.rt;&amp;#10;    psychoJS.experiment.addData(&quot;myPract.RT_correctTrials&quot;, sequenceDataset.RT_correctTrials[practiceBlock.thisN]);&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="import numpy as np&amp;#10;&amp;#10;# observed response&amp;#10;if stroopResp.keys:&amp;#10;    sequenceDataset.observedResponse[practiceBlock.thisN] = stroopResp.keys&amp;#10;else:&amp;#10;    sequenceDataset.observedResponse[practiceBlock.thisN] = 'None'&amp;#10;thisExp.addData('myPract.observedResponse', sequenceDataset.observedResponse[practiceBlock.thisN])&amp;#10;&amp;#10;# Accuracy&amp;#10;if sequenceDataset.nogo[practiceBlock.thisN] == 1:&amp;#10;    sequenceDataset.Accuracy[practiceBlock.thisN]             = int(sequenceDataset.observedResponse[practiceBlock.thisN] == &quot;None&quot;) &amp;#10;else:&amp;#10;    sequenceDataset.Accuracy[practiceBlock.thisN]             = int(sequenceDataset.expectedResponse[practiceBlock.thisN] == sequenceDataset.observedResponse[practiceBlock.thisN]) &amp;#10;thisExp.addData('myPract.Accuracy',         sequenceDataset.Accuracy[practiceBlock.thisN])&amp;#10;&amp;#10;# AccuracyNogo&amp;#10;if sequenceDataset.nogo[practiceBlock.thisN] == 1:&amp;#10;    sequenceDataset.AccuracyNogo[practiceBlock.thisN] = int(sequenceDataset.observedResponse[practiceBlock.thisN] == &quot;None&quot;) &amp;#10;thisExp.addData('myPract.AccuracyNogo',         sequenceDataset.AccuracyNogo[practiceBlock.thisN])&amp;#10;&amp;#10;# RT all trials&amp;#10;if sequenceDataset.nogo[practiceBlock.thisN] != 1:&amp;#10;    sequenceDataset.RT_allTrials[practiceBlock.thisN]         = stroopResp.rt&amp;#10;    thisExp.addData('myPract.RT_allTrials',     sequenceDataset.RT_allTrials[practiceBlock.thisN])&amp;#10;    &amp;#10;# RT correct trials&amp;#10;if sequenceDataset.Accuracy[practiceBlock.thisN] == 1 and sequenceDataset.nogo[practiceBlock.thisN] != 1:&amp;#10;    sequenceDataset.RT_correctTrials[practiceBlock.thisN] = stroopResp.rt&amp;#10;    thisExp.addData('myPract.RT_correctTrials',     sequenceDataset.RT_correctTrials[practiceBlock.thisN])&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="addData" valType="code" updates="None" name="name"/>
      </CodeComponent>
